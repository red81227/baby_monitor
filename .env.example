# 嬰兒監視器部署設定：cp .env.example .env 後修改 (.env 不進 git)
# 標示「必填」的變數沒有設定時，docker compose 會在建立容器前失敗並指出變數名稱。

# ---- 主機使用者 (必填)：容器以此身分執行，寫出的紀錄與片段屬於這個使用者 ----
# 以 `id -u` / `id -g` 查詢
BM_UID=1000
BM_GID=1000

# ---- 時區 (必填)：紀錄檔依當地日期分檔，需與主機相同 ----
# 以 `timedatectl show -p Timezone --value` 查詢
TZ=Asia/Taipei

# ---- 監視頁面 ----
# 對外的 port；BM_BIND 改成 127.0.0.1 時只有本機可以開啟
BM_PORT=18080
BM_BIND=0.0.0.0

# ---- 攝影機 ----
# 裝置路徑 (容器內使用相同路徑)；BM_VIDEO_GID 是該裝置的群組 ID (`stat -c %g /dev/video0`)
BM_CAMERA_DEVICE=/dev/video0
BM_VIDEO_GID=44

# ---- 資料目錄：紀錄 (logs/)、事件片段 (events/) 與網頁設定的 ROI (overrides/) ----
# 第一次啟動前先建立：mkdir -p data/logs data/events data/overrides (Docker 自動建立的目錄會屬於 root，容器無法寫入)
BM_DATA_DIR=./data
# 事件片段占用空間上限 (MB)
BM_EVENT_MAX_MB=2048

# ---- 網路持有者 ----
# monitor 與 vlm 共用這個容器的 network namespace，讓 VLM 只有 monitor 連得到；只需要能執行 sleep 的小映像
NET_IMAGE=alpine:3.22.2

# ---- VLM (llama.cpp server) ----
# 官方 CUDA server 映像，固定 build 編號；換版前先確認主機驅動支援其 CUDA 版本
VLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b12464
# 模型檔所在目錄 (必填，唯讀掛載到容器的 /models)
VLM_MODEL_DIR=/home/you/models/vlm/qwen2.5-vl-3b
# 目錄中的模型檔與 mmproj 檔名
VLM_MODEL_FILE=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
VLM_MMPROJ_FILE=mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf
# 模型名稱：llama-server 的 -a 與 BabyMonitor 的 BM_VLM_MODEL 共用，兩邊不會不一致
VLM_MODEL_NAME=qwen2.5-vl-3b
# context 長度
VLM_CTX=4096
